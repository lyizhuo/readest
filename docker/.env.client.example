# Secrets for docker-compose.client.yaml — copy to .env.client and fill in.
# Never commit real values (this repo is public).
#
#   cp docker/.env.client.example docker/.env.client
#   # edit docker/.env.client with your real keys

# Hosted Supabase (Project Settings -> API)
SUPABASE_ANON_KEY=<paste your anon key>
SUPABASE_ADMIN_KEY=<paste your service_role key>

# Cloudflare R2 API token (R2 -> Manage R2 API Tokens, Object Read & Write on the bucket)
S3_ACCESS_KEY_ID=<paste your R2 access key id>
S3_SECRET_ACCESS_KEY=<paste your R2 secret access key>

# Optional overrides (defaults in the compose file are fine)
# API_BASE_URL=https://read.620602.xyz
# S3_BUCKET_NAME=readest
# STORAGE_FIXED_QUOTA=10737418240
# TRANSLATION_FIXED_QUOTA=1000000
# FONT_BASE_URL=
